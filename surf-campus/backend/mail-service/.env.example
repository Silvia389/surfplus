# Keep disabled until the SMTP account, sender and message template are ready.
MAIL_ENABLED=false
MAIL_PORT=8025
MAIL_HOST=127.0.0.1

# Nodemailer SMTP transport settings.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=

# Fill this when the product copy is finalized.
MAIL_VERIFICATION_SUBJECT=

# Optional shared secret for the Python backend -> mail service call.
MAIL_INTERNAL_TOKEN=
