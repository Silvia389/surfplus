# LLM provider (optional for the campus UI and non-AI API tests)
PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# SMS provider: mock for local development, aliyun for Alibaba Cloud DypnsAPI.
SURF_SMS_PROVIDER=mock
SURF_MOCK_SMS_CODE=123456
SURF_MOCK_EMAIL_CODE=123456
SURF_AUTH_DEBUG_CODES=true
SURF_AUTH_CODE_TTL_SECONDS=600
SURF_AUTH_CODE_COOLDOWN_SECONDS=30

# Alibaba Cloud号码认证服务 / 短信认证 API。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DYPNSAPI_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
ALIYUN_SMS_CODE_LENGTH=6

# Optional generic SMS provider adapter kept for compatibility.
SURF_SMS_PROVIDER_URL=
SURF_SMS_PROVIDER_TOKEN=
SURF_SMS_TEMPLATE=

# Optional SMTP email delivery.
SURF_SMTP_HOST=
SURF_SMTP_PORT=465
SURF_SMTP_SECURITY=ssl
SURF_SMTP_USERNAME=
SURF_SMTP_PASSWORD=
SURF_SMTP_FROM=
SURF_EMAIL_SUBJECT=SURF Campus 验证码

# Development-only campus binding. Production must set this to false.
SURF_ENABLE_MOCK_AUTH=true

# Local test shortcut: only requests from 127.0.0.1/::1 are accepted.
# Keep false in production. `../start-dev.sh` enables it for local testing.
SURF_DEV_AUTH_BYPASS=false
SURF_DEV_FIXED_PHONE_LOGIN=false

# XJTLU OAuth2 / OIDC registration supplied by the university identity team.
XJTLU_OAUTH_CLIENT_ID=
XJTLU_OAUTH_CLIENT_SECRET=
XJTLU_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/xjtlu/callback
XJTLU_OAUTH_AUTHORIZE_URL=https://sso.xjtlu.edu.cn/esc-sso/oauth2.0/authorize
XJTLU_OAUTH_TOKEN_URL=
XJTLU_OAUTH_USERINFO_URL=
XJTLU_OAUTH_ISSUER=https://sso.xjtlu.edu.cn
XJTLU_OAUTH_SCOPE=openid profile email
XJTLU_OAUTH_TOKEN_AUTH=client_secret_post
# Email-code campus binding accepts both official XJTLU mailbox suffixes.
XJTLU_CAMPUS_EMAIL_DOMAINS=student.xjtlu.edu.cn,xjtlu.edu.cn

# Optional standalone Nodemailer service. Keep empty until the SMTP account is ready.
SURF_MAIL_SERVICE_URL=
SURF_MAIL_SERVICE_TOKEN=

# Optional test/development storage isolation.
SURF_DATA_DIR=
SURF_UPLOAD_DIR=
SURF_RESOURCE_FILE_DIR=
